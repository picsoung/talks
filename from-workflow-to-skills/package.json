{
  "name": "from-workflow-to-skills-presentation",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev --open",
    "build": "slidev build",
    "export": "slidev export --format pdf --output from-workflows-to-skills.pdf",
    "export:pptx": "slidev export --format pptx --output from-workflows-to-skills.pptx",
    "setup:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-apple-basic": "^0.25.1",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/theme-seriph": "^0.25.0",
    "playwright-chromium": "^1.63.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "packageManager": "pnpm@10.24.0"
}
